function toIsoDate(value) {
  if (!value || typeof value !== "string") {
    return new Date().toISOString();
  }

  const parsed = new Date(value.replace(/^Published\s+/i, "").trim());
  if (Number.isNaN(parsed.getTime())) {
    return new Date().toISOString();
  }

  return parsed.toISOString();
}

const aboutPathByKey = {
  "goel-group": "/about/goel-group",
  "chairmans-office": "/about/chairmans-office",
  leadership: "/about/leadership",
  "our-journey": "/about/our-journey",
  awards: "/about/awards",
};

const dynamicAboutSeoByPath = Object.entries(aboutPathByKey).reduce(
  (acc, [key, path]) => {
    const page = aboutSubpages[key];

    if (!page) {
      return acc;
    }

    const sectionHeadings = (page.sections || [])
      .map((section) => section.heading)
      .filter(Boolean)
      .slice(0, 3);

    acc[path] = {
      title: page.metaTitle || `${page.title} | Prem Industries India Limited`,
      description:
        page.metaDescription ||
        page.description ||
        "Learn more about Prem Industries India Limited.",
      keywords: getKeywordsForMetadata([
        page.title,
        page.eyebrow,
        ...sectionHeadings,
        "Prem Industries India Limited",
        "industrial manufacturing company India",
      ]),
      image: "/about/banner.jpg",
    };

    return acc;
  },
  {},
);

const dynamicBlogSeoByPath = blogPosts.reduce((acc, post) => {
  const keywords = getKeywordsForMetadata([
    post.title,
    post.category,
    post.venue,
    "Prem Industries India Limited",
    "industrial event update India",
    "manufacturing exhibition India",
  ]);

  acc[`/blogs/${post.slug}`] = {
    title: `${post.title} | Prem Industries India Limited`,
    description: post.excerpt,
    keywords,
    image: post.heroImage || post.coverImage || "/logo-main-desktop.png",
    article: {
      headline: post.title,
      description: post.excerpt,
      image: post.heroImage || post.coverImage || "/logo-main-desktop.png",
      authorName: "Prem Industries India Limited",
      datePublished: toIsoDate(post.publishedLabel),
      dateModified: new Date().toISOString(),
    },
  };

  return acc;
}, {});

const DEFAULT_SEO = {
  title:
    "Industrial Manufacturing Company India | Prem Industries India Limited",
  description:
    "Prem Industries India Limited is an industrial manufacturing company in India providing OEM manufacturing, industrial solutions, and end-to-end manufacturing services.",
  keywords: getKeywordsForMetadata(parentAuthorityKeywords.slice(0, 5)),
  image: "/logo-main-desktop.png",
};

function getPathKeywords(path) {
  const pathTerms = (path || "/")
    .split("/")
    .filter(Boolean)
    .map((segment) => segment.replace(/-/g, " "))
    .filter(Boolean);

  return getKeywordsForMetadata([
    ...pathTerms,
    "Prem Industries India Limited",
    "industrial manufacturing company India",
    "OEM manufacturing company India",
  ]);
}

